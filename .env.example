# Used server-side only, in src/app/api/run-pipeline/route.ts — the AI
# proposes raw-field-to-canonical-field mappings only; it never sees or
# touches actual data values. Never exposed to the client (no
# NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=
# Optional override — defaults to gemini-flash-latest (a live-updating
# alias) if unset.
GEMINI_MODEL=
